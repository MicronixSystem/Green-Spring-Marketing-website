# Static review copy of the rebuilt Green Spring site.
#
# This folder sits inside the live WordPress document root, so two things have
# to be held off: WordPress's front controller, and the search engines.

# WordPress rewrites anything that is not a real file or directory to index.php.
# This is a real directory so it would be served anyway, but switching rewriting
# off here makes that explicit and keeps working if the root rules change.
RewriteEngine Off

# Serve index.html, not index.php, and never a bare directory listing.
DirectoryIndex index.html
Options -Indexes

# A second copy of the site on the live domain is duplicate content and would
# compete with the real pages. robots.txt only works at the domain root, which
# WordPress owns, so the instruction goes out as a header instead. It covers
# every file in this folder without touching the page source.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# Markup and stylesheets are never cached while the page is under review, so a
# re-upload is visible on the client's next refresh. Photographs are large and
# will not change between revisions, so those are cached properly.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>
